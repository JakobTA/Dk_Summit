@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h6">@(IsNew ? "Create Playlist" : "Save Playlist")</MudText>
            <MudChip T="string" Color="Color.Secondary" Size="Size.Small">
                @TrackCount track@(TrackCount == 1 ? "" : "s")
            </MudChip>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name"
                      Label="Playlist name"
                      Variant="Variant.Outlined"
                      AutoFocus="true"
                      OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="Save"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">
            @(IsNew ? "Create" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int TrackCount { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public string InitialName { get; set; } = "";

    private string _name = "";

    protected override void OnInitialized() => _name = InitialName;

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(_name))
            MudDialog.Close(DialogResult.Ok(_name.Trim()));
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Save();
    }
}
